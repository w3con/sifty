#!/usr/bin/env bash
# Rebuild the generated navigation map after switching branches.
# $3 is 1 for a branch checkout and 0 for a single-file checkout; only a
# branch checkout can change which documents exist, so only that one matters.
#
# The knowledge base and its shared tooling are optional: a public clone that
# carries no kb/ directory, or a checkout without the ai/shared submodule
# initialised, must still be able to check out and commit ordinary work. Only
# when kb/ exists does the shared tool become required, and then its absence is
# reported explicitly rather than silently skipped.
set -u
unset GIT_DIR GIT_WORK_TREE
[ "${3:-0}" = "1" ] || exit 0
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
[ -d "$PROJECT_ROOT/kb" ] || exit 0
TOOL="$PROJECT_ROOT/ai/bin/kb-index"
if [ ! -x "$TOOL" ]; then
    echo "[post-checkout] kb/ exists but ai/bin/kb-index is missing; generated index not refreshed" >&2
    exit 1
fi
exec "$TOOL"
