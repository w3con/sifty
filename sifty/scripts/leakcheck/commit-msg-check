#!/usr/bin/env python3
"""commit-msg-check — refuses a commit message that carries a form the census at
scripts/leakcheck/census.md names, or (in a repository the census marks public, or when the
commit touches a formatting-required subtree) that does not follow Conventional Commits.

Usage:
    commit-msg-check <message-file> [--repo PATH] [--commit SHA]

Credential forms are refused everywhere and in every path, including a message that touches
only work records or tooling. Formatting forms and the Conventional-Commits shape apply when the
repository is public or the commit touches a formatting-required subtree. Task identifiers and
`bin/work-*` command names are ordinary content, including in a scope such as `docs(OPS-4)`.

Exit codes: 0 clean; 1 refused, with every finding named; 2 bad invocation or a Git failure.
"""
import argparse
import os
import re
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, SCRIPT_DIR)
import leak_census  # noqa: E402
import leak_git  # noqa: E402

CONVENTIONAL_TYPES = ("feat", "fix", "refactor", "test", "docs", "chore", "build", "ci", "perf")
_SUBJECT_HINT = (
    "the subject line must read 'type(scope): imperative summary', with type one of "
    + ", ".join(CONVENTIONAL_TYPES))


def strip_comment_lines(text):
    return "\n".join(line for line in text.splitlines() if not line.startswith("#"))


def first_content_line(text):
    for line in text.splitlines():
        if line.strip():
            return line
    return ""


def check_conventional_shape(subject):
    type_group = "|".join(CONVENTIONAL_TYPES)
    pattern = re.compile(
        r"^(" + type_group + r")(\([A-Za-z0-9_-]+\))?!?: \S.+")
    if pattern.match(subject):
        return None
    return leak_census.Finding(
        "not Conventional-Commits shaped", "formatting", 1, subject, _SUBJECT_HINT)


def main():
    parser = argparse.ArgumentParser(prog="commit-msg-check", description=__doc__,
                                      formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("message_file")
    parser.add_argument("--repo")
    parser.add_argument("--commit", metavar="SHA",
                        help="SHA of an already-made commit; used to determine which subtrees "
                             "it touches instead of reading staged changes")
    args = parser.parse_args()

    if not os.path.isfile(args.message_file):
        print(f"commit-msg-check: no such file: {args.message_file}", file=sys.stderr)
        return 2

    try:
        if args.repo:
            repo_root = os.path.abspath(args.repo)
        else:
            repo_root = leak_git.run(
                ".", ["rev-parse", "--show-toplevel"], text=True).stdout.strip()
        entries = (leak_git.changed_paths_commit(repo_root, args.commit)
                   if args.commit
                   else leak_git.changed_paths_staged(repo_root))
        origin = leak_git.origin_url(repo_root)
    except leak_git.GitError as exc:
        print("commit-msg-check: "
              + leak_census.redact_sensitive(str(exc)), file=sys.stderr)
        return 2

    try:
        with open(args.message_file, encoding="utf-8") as fh:
            text = strip_comment_lines(fh.read())
    except OSError as exc:
        print("commit-msg-check: cannot read %s: %s"
              % (args.message_file, exc), file=sys.stderr)
        return 2

    census = leak_census.parse_census()
    repo_is_public = leak_census.is_public_repo(origin, census)
    touched = [path for entry in entries for path in leak_git.entry_paths(entry)]
    apply_formatting = any(
        leak_census.is_formatting_required(path, census)
        and not leak_census.formatting_exempt(path)
        for path in touched)

    findings = leak_census.scan_text(
        text, census, apply_formatting=apply_formatting)

    if repo_is_public or apply_formatting:
        shape_finding = check_conventional_shape(first_content_line(text))
        if shape_finding:
            findings.insert(0, shape_finding)

    if findings:
        forms = "1 form" if len(findings) == 1 else f"{len(findings)} forms"
        print("commit-msg-check: refused — %s carries %s this repository's commit messages "
              "must not:" % (leak_census.redact_sensitive(args.message_file), forms),
              file=sys.stderr)
        print(leak_census.format_findings(findings, args.message_file), file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
