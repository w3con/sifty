#!/usr/bin/env python3
"""work-resume — restart a cut-short executor run from the last handoff.

Usage:
    work-resume <id>

Refuses when no worktree exists for branch work/<id>. Otherwise re-renders the
executor brief pointing at the remaining open steps and hands it to the seam.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _work_lib as w


def main():
    ap = argparse.ArgumentParser(prog="work-resume")
    ap.add_argument("id")
    args = ap.parse_args()

    card_dir = w.require_card_dir(args.id)
    branch = "work/%s" % args.id
    worktree = w.find_worktree(branch)
    if not worktree or not os.path.isdir(worktree):
        w.refuse(["no worktree for %s — nothing to resume. Run work-handover %s "
                  "to start." % (branch, args.id)])

    rel_card = os.path.relpath(card_dir, w.repo_root())
    rel_steps = os.path.relpath(w.steps_file(card_dir), w.repo_root())
    # Ticked boxes live on branch work/<id> inside the worktree, never in the base
    # checkout's copy of the card, so read the remaining open steps from the worktree.
    # Reading the base copy would re-list every step as open on each resume.
    steps = w.open_steps(os.path.join(worktree, rel_card))
    open_block = "\n".join("- [ ] %s" % s for s in steps) or "(none — all steps closed)"
    brief = w.render_template(
        "executor-brief.md",
        id=args.id,
        card_dir=rel_card,
        worktree=worktree,
        steps_file=rel_steps,
        open_steps=open_block,
    )
    w.info("resuming %s in %s" % (branch, worktree))
    w.dispatch(brief)


if __name__ == "__main__":
    main()
