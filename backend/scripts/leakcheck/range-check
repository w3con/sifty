#!/usr/bin/env python3
"""range-check — runs commit-msg-check and commit-diff-check against every commit in a range, so
a form committed with --no-verify is still caught before it is pushed.

Usage:
    range-check <range> [--repo PATH]   check every commit `git rev-list <range>` lists
    range-check [--repo PATH]           read git's pre-push protocol from stdin (as a pre-push hook)

Historical checks read the actual commit blobs and messages, including the root commit of a new
branch. A Git failure is reported and exits 2; it is never treated as an empty clean range.

Exit codes: 0 every commit clean; 1 refused, commit by commit; 2 bad invocation or Git failure.
"""
import argparse
import os
import subprocess
import sys
import tempfile

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, SCRIPT_DIR)
import leak_census  # noqa: E402
import leak_git  # noqa: E402

MSG_CHECK = os.path.join(SCRIPT_DIR, "commit-msg-check")
DIFF_CHECK = os.path.join(SCRIPT_DIR, "commit-diff-check")
ZERO_SHA = "0" * 40


def rev_list(repo_root, range_expr):
    out = leak_git.run(repo_root, ["rev-list", "--reverse", range_expr],
                       text=True).stdout
    return [line for line in out.splitlines() if line.strip()]


def commits_for_new_ref(repo_root, local_sha):
    out = leak_git.run(repo_root, ["rev-list", local_sha, "--not", "--remotes"],
                       text=True).stdout
    commits = [line for line in out.splitlines() if line.strip()]
    return list(reversed(commits)) if commits else []


def commits_from_stdin(repo_root):
    commits = []
    seen = set()
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4:
            continue
        _local_ref, local_sha, _remote_ref, remote_sha = parts
        if local_sha == ZERO_SHA:
            continue
        if remote_sha == ZERO_SHA:
            these = commits_for_new_ref(repo_root, local_sha)
        else:
            these = rev_list(repo_root, f"{remote_sha}..{local_sha}")
        for sha in these:
            if sha not in seen:
                seen.add(sha)
                commits.append(sha)
    return commits


def check_one_commit(repo_root, sha):
    """Return (problem_texts, fatal). A check command that cannot run is fatal, not clean."""
    problems = []
    fatal = False
    message = leak_git.run(repo_root, ["log", "-1", "--format=%B", sha],
                           text=True).stdout
    with tempfile.NamedTemporaryFile("w", suffix=".msg", delete=False) as fh:
        fh.write(message)
        msg_path = fh.name
    try:
        result = subprocess.run([MSG_CHECK, msg_path, "--repo", repo_root,
                                 "--commit", sha],
                                capture_output=True, text=True)
        if result.returncode == 1:
            problems.append(result.stderr)
        elif result.returncode not in (0, 1):
            problems.append("commit-msg-check could not run on this commit")
            fatal = True
    finally:
        os.unlink(msg_path)

    result = subprocess.run([DIFF_CHECK, "--repo", repo_root, "--commit", sha],
                            capture_output=True, text=True)
    if result.returncode == 1:
        problems.append(result.stderr)
    elif result.returncode not in (0, 1):
        problems.append("commit-diff-check could not run on this commit")
        fatal = True
    return problems, fatal


def main():
    parser = argparse.ArgumentParser(prog="range-check", description=__doc__,
                                      formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("range", nargs="?")
    parser.add_argument("--repo")
    args = parser.parse_args()

    try:
        if args.repo:
            repo_root = os.path.abspath(args.repo)
        else:
            repo_root = leak_git.run(
                ".", ["rev-parse", "--show-toplevel"], text=True).stdout.strip()
        commits = (rev_list(repo_root, args.range) if args.range
                   else commits_from_stdin(repo_root))
    except leak_git.GitError as exc:
        print("range-check: " + leak_census.redact_sensitive(str(exc)),
              file=sys.stderr)
        return 2

    all_problems = []
    fatal = False
    for sha in commits:
        try:
            problems, check_fatal = check_one_commit(repo_root, sha)
        except leak_git.GitError as exc:
            print("range-check: " + leak_census.redact_sensitive(str(exc)),
                  file=sys.stderr)
            return 2
        fatal = fatal or check_fatal
        if problems:
            all_problems.append(f"commit {sha[:12]}:\n" + "\n".join(problems))

    if all_problems:
        print("range-check: refused — %d of %d commit(s) carry a form this repository "
              "must not push:" % (len(all_problems), len(commits)), file=sys.stderr)
        print("\n\n".join(all_problems), file=sys.stderr)
        return 2 if fatal else 1

    print(f"range-check: {len(commits)} commit(s) checked, clean")
    return 0


if __name__ == "__main__":
    sys.exit(main())
