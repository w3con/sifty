#!/usr/bin/env bash
# Rebuild the generated navigation map after a pull or a merge.
# kb/_index.md is untracked, so nothing brings it in for us; see
# tools/bin/kb-index for the whole story.
#
# The knowledge base and its shared tooling are optional: a public clone with
# no kb/ directory must still merge and commit ordinary work. The shared tool is
# required only when kb/ exists, and its absence is reported explicitly.
set -u
unset GIT_DIR GIT_WORK_TREE
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
[ -d "$PROJECT_ROOT/kb" ] || exit 0
TOOL="$PROJECT_ROOT/tools/bin/kb-index"
if [ ! -x "$TOOL" ]; then
    echo "[post-merge] kb/ exists but tools/bin/kb-index is missing; generated index not refreshed" >&2
    exit 1
fi
exec "$TOOL"
