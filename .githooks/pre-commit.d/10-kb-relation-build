#!/usr/bin/env bash
# .githooks/pre-commit
# Layer 2 KB freshness: run tools/bin/relation-build on staged kb/ docs, then
# re-stage the processed files.
#
# kb/_index.md is deliberately NOT re-staged and never was committable since
# it left version control: it is generated, it is listed in .gitignore, and it
# is rebuilt by tools/bin/kb-index from the post-merge, post-checkout and
# post-rewrite hooks and at session start.
#
# Optional integration: a public clone with no kb/ directory skips this step
# entirely and does not need the shared submodule. If kb/ docs are staged and
# the shared tool is absent, the missing required tool is reported explicitly
# and the commit is refused. A tool that runs but fails for a transient reason
# (network, model key, timeout) is still non-blocking, so unrelated work is not
# held hostage to the knowledge-base service.

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
KB_DIR="$PROJECT_ROOT/kb"
[ -d "$KB_DIR" ] || exit 0

# ── Collect staged kb/ markdown (Added, Copied, Modified — not Deleted) ──────
# core.quotePath=false: emit non-ASCII paths as raw UTF-8 bytes, not as
# octal-escaped, double-quoted strings (e.g. "…march\303\251…"). Without this,
# the quoted string flows into relation-build and `git add` verbatim and both
# fail to match files whose names contain accented characters (é, etc.).
STAGED_KB=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM -- 'kb/**/*.md' 'kb/*.md')

if [ -z "$STAGED_KB" ]; then
    # Fast path: no kb/ docs staged — nothing to do.
    exit 0
fi

# ── Filter: exclude meta/generated paths under kb/ ───────────────────────────
# Drop any staged path whose first component under kb/ starts with "_": the
# generated index (kb/_index.md), the Templater skeletons (kb/_templates/), and
# any other top-level _-prefixed file or folder. This mirrors relation-build's
# own discover_docs, which excludes rel_parts[0].startswith("_"). Such paths are
# not real KB notes, so relation-build must neither parse them nor inject an ai:
# block into them (a template's <% %> frontmatter is not valid YAML and would be
# corrupted). Per-note _-prefixed files inside a real collection (e.g.
# kb/BizDev/_tracker.md) are NOT dropped — their first component is the
# collection, not "_".
CONTENT_KB=""
while IFS= read -r rel; do
    sub="${rel#kb/}"
    case "$sub" in
        _*) continue ;;
        */_*/*) continue ;;   # nested _-prefixed dir (e.g. .../_archive/); leaf _-files like _tracker.md are kept
    esac
    CONTENT_KB="${CONTENT_KB}${rel}"$'\n'
done <<< "$STAGED_KB"

CONTENT_KB="${CONTENT_KB%$'\n'}"  # trim trailing newline

if [ -z "$CONTENT_KB" ]; then
    # Only the generated index was staged — nothing for relation-build to do.
    exit 0
fi

RELATION_BUILD="$PROJECT_ROOT/tools/bin/relation-build"
if [ ! -x "$RELATION_BUILD" ]; then
    echo "[pre-commit] ERROR: kb/ docs are staged but tools/bin/relation-build is missing." >&2
    echo "[pre-commit] Initialise the optional shared submodule or unstage the kb/ docs." >&2
    exit 1
fi

echo "[pre-commit] kb/ docs staged — running relation-build..." >&2

# ── Run relation-build on exactly those paths ─────────────────────────────────
# Pass absolute paths so the script works regardless of cwd.
ABS_PATHS=()
while IFS= read -r rel; do
    ABS_PATHS+=("$PROJECT_ROOT/$rel")
done <<< "$CONTENT_KB"

"$RELATION_BUILD" --ids "${ABS_PATHS[@]}"
RB_EXIT=$?

if [ $RB_EXIT -ne 0 ]; then
    echo "[pre-commit] WARNING: relation-build exited $RB_EXIT — ai: blocks may be stale." >&2
    echo "[pre-commit] Commit will proceed. Re-run 'tools/bin/relation-build --ids <paths>' manually if needed." >&2
    # Do NOT exit non-zero — never block the commit on a model/network failure.
fi

# ── Re-stage the processed docs ──────────────────────────────────────────────
# relation-build may have updated frontmatter and the Related footer in those
# files, so they have to go back into the index. Use paths relative to
# PROJECT_ROOT with "git -C" — git rejects absolute paths on some systems
# (macOS with non-standard volume mount points). The generated navigation map
# is untracked and is deliberately left alone here.

REL_PATHS=()
while IFS= read -r rel; do
    REL_PATHS+=("$rel")
done <<< "$CONTENT_KB"

git -C "$PROJECT_ROOT" add -- "${REL_PATHS[@]}"

exit 0
