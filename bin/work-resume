#!/usr/bin/env python3
"""work-resume — restart a cut-short executor run from the last handoff.

Usage:
    work-resume <id>

Refuses when no worktree exists for branch work/<id>. Otherwise re-renders the
executor brief pointing at the remaining open steps and hands it to the seam.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _work_lib as w


def main():
    ap = argparse.ArgumentParser(prog="work-resume")
    ap.add_argument("id")
    args = ap.parse_args()

    branch = "work/%s" % args.id
    worktree = w.find_worktree(branch)
    if not worktree or not os.path.isdir(worktree):
        w.refuse(["no worktree for %s — nothing to resume. Run work-handover %s "
                  "to start." % (branch, args.id)])

    # Ticked boxes live on branch work/<id> inside the worktree, never in the
    # base checkout's copy of the card. Resolve the card inside the worktree by
    # ID so resume also works while an in-progress relocation leaves the base
    # checkout on the old path and the work branch on the new one.
    card_dir = w.find_card_dir(args.id, root=worktree)
    if not card_dir:
        w.refuse(["card %s is not present in %s; the work branch is incomplete"
                  % (args.id, worktree)])
    state = w.card_state(card_dir)
    if state["errors"]:
        w.refuse(["cannot resume %s: %s"
                  % (args.id, "; ".join(state["errors"]))])
    if state["terminal"]:
        w.refuse(["cannot resume %s: terminal outcome %s present"
                  % (args.id, state["state"])])
    if state["blockers"]:
        w.refuse(["cannot resume %s: unresolved blocker: %s"
                  % (args.id, "; ".join(state["blockers"]))])
    attention = w.open_attention(card_dir)
    if attention:
        w.refuse(["cannot resume %s: unresolved attention (%d open item(s))"
                  % (args.id, len(attention))])

    rel_card = os.path.relpath(card_dir, worktree)
    rel_steps = os.path.relpath(w.steps_file(card_dir), worktree)
    steps = w.open_steps(card_dir)
    open_block = "\n".join("- [ ] %s" % s for s in steps) or "(none — all steps closed)"
    next_step = state["next_step"] or (
        "none — all steps closed" if state["steps_closed"] else
        "none — no steps prepared")
    base_root = w.base_checkout_root()
    base_card = w.find_card_dir(args.id, root=base_root)
    base_state = w.card_state(base_card) if base_card else None
    context = ""
    if base_state and base_state["state"] != state["state"]:
        context = ("- Base checkout still records: %s\n"
                   % base_state["state"])
    brief = w.render_template(
        "executor-brief.md",
        id=args.id,
        card_dir=rel_card,
        worktree=worktree,
        steps_file=rel_steps,
        open_steps=open_block,
        state=state["state"],
        blocker="; ".join(state["blockers"]) or "none",
        next_step=next_step,
        state_context=context,
    )
    w.info("resuming %s in %s" % (branch, worktree))
    w.dispatch(brief)


if __name__ == "__main__":
    main()
