#!/usr/bin/env bash
# work-setup — wire a fresh clone for the work-management harness.
#
# core.hooksPath is local git config and is never cloned, so every clone runs
# this once. It is set to the RELATIVE path .githooks so it resolves correctly
# in the main checkout and in every linked worktree. Idempotent.
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

git config core.hooksPath .githooks
echo "set core.hooksPath = .githooks (relative)"

# Make the hooks and their steps executable.
chmod +x .githooks/* 2>/dev/null || true
if [ -d .githooks/pre-commit.d ]; then
    chmod +x .githooks/pre-commit.d/* 2>/dev/null || true
fi

# Make the harness commands executable.
chmod +x bin/work-* bin/work-setup 2>/dev/null || true

echo "hooks and bin/work-* are executable"
echo
echo "If this repository uses the ai/shared submodule, also run:"
echo "  git submodule update --init ai/shared"
echo
echo "harness ready. Run bin/work-test to verify."
