# macOS metadata
.DS_Store

# App data directories — persistent but not versioned
data/
data-staging/

# SQLite runtime files
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.bak*

# Frontend build artifacts
node_modules
app/dist/
frontend/dist/
frontend/dist-staging/
legacy/app/dist/
legacy/app/dist-staging/
sifty/dist/
sifty/dist-staging/
bin/sifty

# Backend build and test outputs
/backend/bin/
/backend/dist/
/backend/build/
/backend/*.test
/backend/*.out

# Runtime/local logs (task records are markdown and stay tracked)
*.log
/logs/

# Python build artifacts
bin/__pycache__/
**/__pycache__/
*.pyc

# Work-management harness: executor worktrees and scratch copies (generated)
.worktrees/
.work-scratch/

# Local runtime state
.local/
.env

# Local incident record: contents stay on this machine, never published
/work/incidents.md

# Obsidian vault internals
.obsidian/

# Local AI cache
.ai/docs/
.ai/logs/

# deploy build artifacts (never commit compiled binaries)
bin/sifty.prev
bin/sifty.new
bin/sifty-staging
bin/sifty-staging.new
bin/sifty-staging.prev
app/dist-staging/
