#!/usr/bin/env python3
"""sift-promote — release one explicitly approved source revision to production.

Usage:
    sift-promote --source <revision> --approve <revision> [--adopt-legacy] [--check]
    sift-promote --help

This is the only command that updates production. It is the configured
WORK_RELEASE_CMD for this repository, so `work-finish <card> --approve <sha>`
runs it with WORK_SOURCE_SHA and WORK_APPROVAL set to the pinned source.

The source and the approval must resolve to the same commit. That commit is
materialized by `bin/sift-deploy --source`, built, published and health-checked
as production. A moving or dirty main checkout is never used as the source.

`--adopt-legacy` is the one explicit first-transition operation for a server
started before the isolated artifact layout existed. It verifies the actual
listening process (binary, data, bundle and worker arguments), captures the
assets that process is actually serving for rollback, records its pid safely,
and only then performs the normal approved-source deploy. It never adopts or
kills an arbitrary port occupant.

`--check` resolves and prints the approved source and deploy command without
touching production. When `WORK_RELEASE_RECOVERY=1` is set by `work-finish`
after a successful release that could not be published, this command instead verifies the release receipt pinned to the finish's
source/squash/approval and current build, restores that captured recovery
point, and reports `RECOVERY result=OK|FAILED|REFUSED`.

No other command deploys production. `bin/sift-deploy --env staging` is the
staging path and never promotes.
"""
import argparse
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _deploy_lib as d


def resolve(app_home, value, label):
    try:
        return d.git(app_home, "rev-parse", "--verify", value + "^{commit}")
    except d.DeployError as exc:
        raise SystemExit("sift-promote: ERROR: %s %r is not a commit: %s"
                         % (label, value, exc))


def recover(app_home, main_repo, reason):
    """Restore only this finish transaction's pinned production recovery point."""
    cfg = d.load_config(app_home)
    prod, staging, shared = d.all_configs(app_home, main_repo, cfg)
    state_root = shared["state_root"]
    point, error = d.verify_release_receipt(
        state_root, prod,
        os.environ.get("WORK_SOURCE_SHA", ""),
        os.environ.get("WORK_SQUASH_SHA", ""),
        os.environ.get("WORK_APPROVAL", ""))
    if error:
        print("sift-promote: RECOVERY result=REFUSED reason=%s" % error)
        return 1
    print("sift-promote: RECOVERY requested reason=%s point=%s"
          % (reason, point))
    command = [sys.executable, str(app_home / "bin" / "sift-deploy"),
               "--env", "prod", "--recover", str(point)]
    code = subprocess.call(command, cwd=str(app_home))
    print("sift-promote: RECOVERY result=%s point=%s"
          % ("OK" if code == 0 else "FAILED", point))
    return code


def main():
    parser = argparse.ArgumentParser(prog="sift-promote")
    parser.add_argument("--source", default=os.environ.get("WORK_SOURCE_SHA"),
                        help="pinned source revision to build and release")
    parser.add_argument("--approve", default=os.environ.get("WORK_APPROVAL"),
                        help="explicit owner approval; must equal --source")
    parser.add_argument("--adopt-legacy", action="store_true",
                        help="explicitly adopt the current legacy production "
                             "process before the approved-source deploy")
    parser.add_argument("--check", action="store_true",
                        help="verify source/approval and print the deploy "
                             "command without touching production")
    parser.add_argument("--force", action="store_true",
                        help="accepted for compatibility; it does not bypass "
                             "source approval")
    args = parser.parse_args()
    app_home, main_repo = d.repo_roots(__file__)
    if os.environ.get("WORK_RELEASE_RECOVERY") == "1":
        return recover(app_home, main_repo,
                       os.environ.get("WORK_RELEASE_RECOVERY_REASON", ""))
    if args.check and os.environ.get("WORK_RELEASE") == "1":
        raise SystemExit(
            "sift-promote: ERROR: --check cannot be used as a release adapter; "
            "it would report success without deploying")

    if not args.source:
        raise SystemExit(
            "sift-promote: ERROR: --source <revision> is required; production "
            "is released only from an explicitly pinned revision")
    if not args.approve:
        raise SystemExit(
            "sift-promote: ERROR: --approve <revision> is required; running "
            "the command is not an owner approval")
    source = resolve(app_home, args.source, "source")
    approval = resolve(app_home, args.approve, "approval")
    if source != approval:
        raise SystemExit(
            "sift-promote: ERROR: approval %s does not match source %s"
            % (approval, source))

    deploy = [sys.executable, str(app_home / "bin" / "sift-deploy"),
              "--env", "prod", "--source", source]
    if args.adopt_legacy:
        deploy.append("--adopt-legacy")
    print("sift-promote: approved source %s" % source)
    print("sift-promote: build/release command: %s" % " ".join(deploy))
    if args.check:
        return 0
    code = subprocess.call(deploy, cwd=str(app_home))
    if code != 0:
        return code
    prod, staging, shared = d.all_configs(app_home, main_repo,
                                          d.load_config(app_home))
    state_root = shared["state_root"]
    state = d.read_json(d.deploy_state_path(state_root, "prod")) or {}
    if state.get("result") != "OK" or state.get("sourceSha") != source:
        print("sift-promote: ERROR: deploy returned success but state does not "
              "match the approved source")
        return 1
    receipt = d.write_release_receipt(
        state_root, source, os.environ.get("WORK_SQUASH_SHA", ""),
        approval, state)
    print("sift-promote: release receipt pinned source=%s squash=%s build=%s"
          % (receipt["sourceSha"][:12], receipt["squashSha"][:12],
             receipt["buildId"]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
