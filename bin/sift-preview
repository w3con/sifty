#!/usr/bin/env python3
"""sift-preview — continuous preview of one active card worktree.

Usage:
  sift-preview start [--worktree PATH] [--label NAME] [--port PORT]
                     [--data-dir PATH] [--state-dir PATH]
                     [--poll SECONDS] [--debounce SECONDS]
  sift-preview status [--json] [--state-dir PATH]
  sift-preview stop [--state-dir PATH]
  sift-preview once [--no-serve] [same source options as start]

The supervisor watches frontend, backend and worker sources including
uncommitted and untracked files. It debounces changes, builds immutable
generations in <main>/.local/preview, keeps the last healthy generation when a
build fails, and exposes /__preview/status plus a browser banner through a
local reverse proxy. It never modifies production server code.

One preview owner per main repository is enforced with an OS file lock. A
second start is refused; stop never kills a process whose recorded owner token
and pid do not match. No work-* command starts a preview automatically; the
phase-6.3 adapter seam is `sift-preview start --worktree <path> --label <id>`.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _preview_lib as p


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("--help", "-h", "help"):
        print(__doc__.strip())
        return 0
    command, rest = argv[0], argv[1:]
    try:
        if command == "start":
            return p.start_main(__file__, rest)
        if command == "status":
            return p.status_main(__file__, rest)
        if command == "stop":
            return p.stop_main(__file__, rest)
        if command == "once":
            return p.once_main(__file__, rest)
        if command == "_run":
            return p.run_main(__file__, rest)
    except p.PreviewError as exc:
        print("sift-preview: ERROR: %s" % exc, file=sys.stderr)
        return 1
    print("sift-preview: unknown command %r (try --help)" % command, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
