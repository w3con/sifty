#!/usr/bin/env python3
"""work-test — opt-in harness checks during rapid prototyping.

Automated tests are paused by default. Use --full, or explicitly set
WORK_TEST_MODE=full, to run the preserved suite. A skipped run is not a pass.

Runs the harness's own checks: every work-* script and the shared lib compile,
the template set is complete, the convention and AGENTS.md are present, AGENTS.md
carries the rules inline (no @-import of the mechanism), each command parses its
--help, and the lifecycle tests in bin/tests run against isolated temporary Git
repositories. Exits non-zero if any check fails. The CI workflow and work-accept
both call this.
"""
import argparse
import os
import py_compile
import subprocess
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--full", action="store_true",
                    help="explicitly run the preserved full harness suite")
args = parser.parse_args()
if not args.full and os.environ.get("WORK_TEST_MODE") != "full":
    print("SKIPPED: automated tests are paused during rapid prototyping. "
          "Use bin/work-test --full to run them explicitly.")
    sys.exit(0)

ROOT = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                      text=True, stdout=subprocess.PIPE).stdout.strip()
BIN = os.path.join(ROOT, "bin")
TEMPLATES = os.path.join(BIN, "templates")

COMMANDS = ["work-new", "work-plan", "work-handover", "work-note",
            "work-commit", "work-resume", "work-accept", "work-finish",
            "work-status", "work-list", "work-capture", "work-cancel"]
TOOLS = ["sift-deploy", "sift-data-refresh", "sift-preview"]
MAP_TOOL = "map-check"
TEMPLATE_FILES = ["convention.md", "description.md", "short-description.md",
                  "plan.md", "log.md", "comments.md", "attention.md",
                  "executor-brief.md", "capture.md"]

failures = []


def check(name, ok, detail=""):
    if ok:
        print("ok   %s" % name)
    else:
        print("FAIL %s%s" % (name, (" — " + detail) if detail else ""))
        failures.append(name)


# 1. compile
for f in ["_work_lib.py", "_map_lib.py", "_deploy_lib.py", "_preview_lib.py"] + COMMANDS + TOOLS + [MAP_TOOL]:
    path = os.path.join(BIN, f)
    if not os.path.exists(path):
        check("compile %s" % f, False, "missing")
        continue
    try:
        py_compile.compile(path, doraise=True)
        check("compile %s" % f, True)
    except py_compile.PyCompileError as e:
        check("compile %s" % f, False, str(e))

# 2. templates present
for t in TEMPLATE_FILES:
    check("template %s" % t, os.path.exists(os.path.join(TEMPLATES, t)))

# 3. AGENTS.md present, rules inline, no @-import of the mechanism
agents = os.path.join(ROOT, "AGENTS.md")
if not os.path.exists(agents):
    check("AGENTS.md present", False, "missing")
else:
    text = open(agents, encoding="utf-8").read()
    check("AGENTS.md present", True)
    check("AGENTS.md names the commands",
          all(c in text for c in COMMANDS),
          "a work-* command is not documented")
    # No bare @-import line (only Claude Code expands those; the rules must be
    # inline so opencode and a bare shell read them too).
    has_import = any(line.strip().startswith("@") for line in text.splitlines())
    check("AGENTS.md has no @-import of the mechanism", not has_import)

# 4. each work command and the map checker parse --help
for c in COMMANDS + TOOLS + [MAP_TOOL]:
    path = os.path.join(BIN, c)
    if not os.path.exists(path):
        continue
    r = subprocess.run([sys.executable, path, "--help"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                       text=True)
    check("--help %s" % c, r.returncode == 0, r.stderr.strip()[:120])

# 5. active navigation map: local links, fragments, requirement IDs and card index
r = subprocess.run([sys.executable, os.path.join(BIN, MAP_TOOL)],
                   cwd=ROOT, text=True, stdout=subprocess.PIPE,
                   stderr=subprocess.STDOUT)
ok = r.returncode == 0
check("navigation map links", ok,
      "" if ok else (r.stdout or "").strip()[-2000:])
if not ok:
    print(r.stdout)

# 6. lifecycle tests, each in its own throwaway Git repository
tests_dir = os.path.join(BIN, "tests")
if not os.path.isdir(tests_dir):
    check("lifecycle tests (bin/tests)", False, "missing bin/tests")
else:
    r = subprocess.run(
        [sys.executable, "-m", "unittest", "discover",
         "-s", tests_dir, "-p", "test_*.py"],
        cwd=ROOT, text=True, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT)
    ok = r.returncode == 0
    check("lifecycle tests (bin/tests)", ok,
          "" if ok else (r.stdout or "").strip()[-2000:])
    if not ok:
        print(r.stdout)

# 7. leak scanner: policy self-test, isolated Git checks and its own source cleanliness
scanner_dir = os.path.join(ROOT, "backend", "scripts", "leakcheck")
selftest = os.path.join(scanner_dir, "leakcheck-selftest")
scanner_tests = os.path.join(scanner_dir, "tests")
tree_check = os.path.join(scanner_dir, "tree-check")
if not os.path.isfile(selftest):
    check("leak scanner present", False, "missing " + selftest)
else:
    r = subprocess.run([sys.executable, selftest], cwd=ROOT, text=True,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    ok = r.returncode == 0
    check("leak scanner self-test", ok,
          "" if ok else (r.stdout or "").strip()[-2000:])
    if not ok:
        print(r.stdout)

if not os.path.isdir(scanner_tests):
    check("leak scanner tests (backend/scripts/leakcheck/tests)", False,
          "missing tests directory")
else:
    r = subprocess.run(
        [sys.executable, "-m", "unittest", "discover",
         "-s", scanner_tests, "-p", "test_*.py"],
        cwd=ROOT, text=True, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT)
    ok = r.returncode == 0
    check("leak scanner tests (backend/scripts/leakcheck/tests)", ok,
          "" if ok else (r.stdout or "").strip()[-2000:])
    if not ok:
        print(r.stdout)

if os.path.isfile(tree_check):
    r = subprocess.run(
        [sys.executable, tree_check, ROOT, "--subtree", "backend/scripts/leakcheck/"],
        cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    ok = r.returncode == 0
    check("leak scanner own sources clean", ok,
          "" if ok else (r.stdout or "").strip()[-2000:])
    if not ok:
        print(r.stdout)

# 8. GitHub discovers the root workflow and no stale nested copy shadows it.
root_workflow = os.path.join(ROOT, ".github", "workflows", "ci.yml")
nested_workflow = os.path.join(ROOT, "backend", ".github", "workflows", "ci.yml")
check("root CI workflow present", os.path.isfile(root_workflow),
      "missing .github/workflows/ci.yml")
check("preview banner asset present",
      os.path.isfile(os.path.join(BIN, "preview-client.js")),
      "missing bin/preview-client.js")
check("no nested CI workflow", not os.path.exists(nested_workflow),
      "backend/.github/workflows/ci.yml should not exist")

print()
if failures:
    print("FAILED: %d check(s)" % len(failures))
    sys.exit(1)
print("PASS: all harness checks")
