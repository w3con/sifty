#!/usr/bin/env python3
"""work-cancel — record cancellation as an archived unsuccessful outcome.

Usage:
    work-cancel <id> --reason "<reason>"

Writes cancelled.md, commits only that file and preserves any work branch,
worktree and uncommitted work. It never merges, removes a worktree or treats the
cancellation as successful completion. Use `work-finish --reject` for a card
that was reviewed and rejected, and `work-finish` for successful completion.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _work_lib as w


def main():
    ap = argparse.ArgumentParser(prog="work-cancel")
    ap.add_argument("id")
    ap.add_argument("--reason", required=True)
    args = ap.parse_args()

    reason = args.reason.strip()
    if not reason:
        w.die("--reason must not be empty")

    card_dir = w.require_card_dir(args.id)
    state = w.card_state(card_dir)
    if state["errors"]:
        w.refuse(["cannot cancel %s: %s"
                  % (args.id, "; ".join(state["errors"]))])
    if state["terminal"]:
        w.refuse(["cannot cancel %s: terminal outcome %s already present"
                  % (args.id, state["state"])])

    branch = "work/%s" % args.id
    tip = w.git_rev(branch)
    tip_line = ("**Branch tip preserved:** %s\n" % tip) if tip else \
               ("**Branch tip preserved:** none (no work branch)\n")
    body = (
        "# %s — cancelled\n\n"
        "**Date:** %s\n"
        "**Reason:** %s\n"
        "%s\n"
        "This is an archived unsuccessful outcome, not successful completion. "
        "Any work branch, worktree and uncommitted work are preserved; nothing "
        "was merged or removed.\n"
        % (args.id, w.today(), reason, tip_line)
    )
    path = os.path.join(card_dir, "cancelled.md")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(body)
    w.commit_paths([path], "chore(work): cancel %s" % args.id)
    w.info("cancelled %s; work branch and worktree preserved" % args.id)


if __name__ == "__main__":
    main()
