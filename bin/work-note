#!/usr/bin/env python3
"""work-note — record a step (with verbatim check output) or a note in log.md.

Usage:
    work-note <id> --step "<name>" --check "<shell command>"
    work-note <id> --message "<free note>"

With --check, the command is run in the current directory (the executor's
worktree), and its combined output and exit code are written verbatim into the
card's log.md. The log is the durable proof a step passed; it is never
hand-summarised.
"""
import argparse
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _work_lib as w


def main():
    ap = argparse.ArgumentParser(prog="work-note")
    ap.add_argument("id")
    ap.add_argument("--step", default=None, help="step name being recorded")
    ap.add_argument("--check", default=None, help="shell command to run and record")
    ap.add_argument("--message", default=None, help="free-text note")
    args = ap.parse_args()

    card_dir = w.require_card_dir(args.id)
    log_path = os.path.join(card_dir, "log.md")
    if w.is_short_card(card_dir):
        # short cards keep no log.md; record into comments.md instead
        log_path = os.path.join(card_dir, "comments.md")

    if not args.message and not args.check:
        w.die("nothing to record: pass --check or --message")

    entry = ["", "## %s — %s" % (w.today(), args.step or "note"), ""]

    if args.message:
        entry += [args.message, ""]

    exit_code = 0
    if args.check:
        proc = subprocess.run(args.check, shell=True, text=True,
                              stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT,
                              cwd=os.getcwd())
        exit_code = proc.returncode
        output = proc.stdout if proc.stdout is not None else ""
        entry += [
            "Check: `%s`" % args.check,
            "Exit: %d" % exit_code,
            "",
            "```",
            output.rstrip("\n"),
            "```",
            "",
        ]

    with open(log_path, "a", encoding="utf-8") as fh:
        fh.write("\n".join(entry) + "\n")

    w.info("recorded to %s" % os.path.relpath(log_path, w.repo_root()))
    # Propagate a failing check so the executor notices.
    sys.exit(1 if exit_code != 0 else 0)


if __name__ == "__main__":
    main()
