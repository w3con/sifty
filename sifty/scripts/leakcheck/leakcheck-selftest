#!/usr/bin/env python3
"""leakcheck-selftest — proves the scanner flags a seeded secret of each form it claims to catch
and passes a clean sample and obvious placeholders. Exit 0 all pass, 1 any fail.
"""
import os
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, SCRIPT_DIR)
import leak_census  # noqa: E402

CENSUS = leak_census.parse_census()
PREFIXES = leak_census.discover_card_prefixes()

# Seeded secrets, assembled at runtime so this file itself carries no real-looking credential.
AKIA = "AKIA" + "ABCDEFGHIJKLMNOP"
GHP = "ghp_" + "a" * 36
AIZA = "AIza" + "B" * 35
JWT = "eyJ" + "a" * 20 + ".eyJ" + "b" * 20 + "." + "c" * 20
PEM = "-----BEGIN " + "RSA PRIVATE KEY" + "-----"
SECRET_VALUE = "9f8d7a6b5c4e" + "3f2a1b0c9d8e"

MUST_FLAG = [
    ("cloud access key", f"const id = '{AKIA}'"),
    ("personal access token", f"token: {GHP}"),
    ("cloud API key", f"GOOGLE_KEY {AIZA}"),
    ("JSON Web Token", f"auth = {JWT}"),
    ("private key (PEM block)", PEM),
    ("secret assigned a real value", f"api_key = {SECRET_VALUE}"),
    (".env file content", "DATABASE_URL=postgres://u:p@db/app"),
]

MUST_PASS = [
    "fitScore := assess(candidate, posting)",
    "api_key = ${SIFTY_API_KEY}",
    "export API_KEY from the environment",
    "token: your-token-here",
    "password = <changeme>",
    "// read the key from a local file the .gitignore excludes",
]


def forms_in(text):
    findings = leak_census.scan_text(text, CENSUS, PREFIXES, is_public=True)
    return {f.form for f in findings}


def main():
    failures = []
    for form, text in MUST_FLAG:
        found = forms_in(text)
        if form not in found:
            failures.append(f"MISS: {form!r} not flagged in {text!r} (found {sorted(found)})")
        else:
            print(f"ok  flag  [{form}]")
    for text in MUST_PASS:
        found = forms_in(text)
        irreversible = {f.form for f in leak_census.scan_text(text, CENSUS, PREFIXES, True)
                        if f.cls == "irreversible"}
        if irreversible:
            failures.append(f"FALSE POSITIVE: {sorted(irreversible)} on clean line {text!r}")
        else:
            print(f"ok  pass  {text!r}")

    if failures:
        print("\nFAILURES:")
        print("\n".join(failures))
        return 1
    print(f"\nPASS: {len(MUST_FLAG)} seeded secrets flagged, {len(MUST_PASS)} clean lines passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
