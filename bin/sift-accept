#!/usr/bin/env bash
# bin/sift-accept — acceptance check for a sifty card.
#
# Run by work-accept / work-finish as the WORK_ACCEPT_CMD. The harness self-test
# always runs. Application checks also run when the card changed application
# source (sifty/** or app/**) or build/deploy/configuration inputs:
#
#   bin/sift-*  bin/work.config  Makefile  config/**  .github/**
#
#   Harness self-test       → bin/work-test (always)
#   Application checks      → go test -race ./...  +  npm ci  +  npm run build
#                             (tsc --noEmit + vite build)
#
# A card is app/build-touching when any committed file on this branch (relative
# to the merge base with the base branch) matches those paths. The base branch
# defaults to WORK_BASE_BRANCH, then SIFTY_BASE_BRANCH, then main.
#
# npm ci is required; a failure fails acceptance rather than silently falling
# back to npm install. The frontend build writes to a temporary directory so the
# scratch copy stays removable without force.
#
# Exit 0 = pass. Exit non-zero = fail (the card is not accepted or merged).

set -euo pipefail

log()  { echo "sift-accept: $*"; }
die()  { echo "sift-accept: FAIL: $*" >&2; exit 1; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_HOME="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null)" \
    || die "not inside a git repository"

BASE_BRANCH="${WORK_BASE_BRANCH:-${SIFTY_BASE_BRANCH:-main}}"

# Find the merge base between HEAD and the base branch.
MERGE_BASE="$(git -C "$APP_HOME" merge-base "$BASE_BRANCH" HEAD 2>/dev/null \
    || git -C "$APP_HOME" merge-base origin/"$BASE_BRANCH" HEAD 2>/dev/null \
    || echo "")"

APP_TOUCHING=0
BUILD_TOUCHING=0

if [[ -z "$MERGE_BASE" ]]; then
    log "Cannot find merge base with $BASE_BRANCH; running application checks to be safe."
    APP_TOUCHING=1
    BUILD_TOUCHING=1
else
    CHANGED="$(git -C "$APP_HOME" diff --name-only "$MERGE_BASE" HEAD 2>/dev/null || true)"
    if echo "$CHANGED" | grep -qE '^(sifty|app)/'; then
        APP_TOUCHING=1
    fi
    if echo "$CHANGED" | grep -qE '^(bin/sift-[^/]+|bin/work\.config|Makefile|config/|\.github/)'; then
        BUILD_TOUCHING=1
    fi
    if [[ "$APP_TOUCHING" -eq 1 || "$BUILD_TOUCHING" -eq 1 ]]; then
        log "Application/build files changed; running application checks."
    else
        log "No application/build files changed; running harness self-test only."
    fi
fi

# 1. The harness self-test always runs, whatever the card touched.
log "--- Harness self-test (bin/work-test) ---"
python3 "$APP_HOME/bin/work-test" || die "Harness self-test failed"
log "Harness self-test: PASS"

# 2. Application checks when source, build, deploy or configuration inputs changed.
if [[ "$APP_TOUCHING" -eq 1 || "$BUILD_TOUCHING" -eq 1 ]]; then
    log "--- Go tests (go test -race ./...) ---"
    (cd "$APP_HOME/sifty" && go test -race ./...) || die "Go tests failed"
    log "Go tests: PASS"

    log "--- Frontend dependencies (npm ci) ---"
    (cd "$APP_HOME/sifty/web" && npm ci --silent) \
        || die "frontend dependency install failed (npm ci); not falling back to npm install"
    log "Frontend dependencies: PASS"

    BUILD_DIR="$(mktemp -d "${TMPDIR:-/tmp}/sifty-accept-build.XXXXXX")"
    trap 'rm -rf "$BUILD_DIR"' EXIT
    log "--- TypeScript check + Vite build (BUILD_OUTDIR=$BUILD_DIR) ---"
    (cd "$APP_HOME/sifty/web" && BUILD_OUTDIR="$BUILD_DIR" npm run build) \
        || die "tsc --noEmit or vite build failed"
    log "tsc + vite build: PASS"
fi

log "Acceptance checks passed."
