# work-* harness configuration. KEY=VALUE, # comments. An environment variable
# of the same name overrides the value here. All keys are optional.

# Headless dispatch command: the prompt is piped to it on stdin. Set to your
# tool's non-interactive invocation. Never hardcoded in the scripts.
# WORK_DISPATCH_CMD=claude -p
# WORK_DISPATCH_CMD=opencode run

# Acceptance command run in a scratch copy by work-accept / work-finish.
# WORK_ACCEPT_CMD=bin/work-test

# Refuse handover when a plan's declared estimate exceeds this many steps.
# WORK_ESTIMATE_CEILING=25

# Set to 1 to let work-finish push after a successful merge. Off by default.
# WORK_PUSH=0
