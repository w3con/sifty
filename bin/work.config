# work-* harness configuration. KEY=VALUE, # comments. An environment variable
# of the same name overrides the value here. All keys are optional.

# Headless dispatch command: the prompt is piped to it on stdin. Set to your
# tool's non-interactive invocation. Never hardcoded in the scripts.
# WORK_DISPATCH_CMD=claude -p
# WORK_DISPATCH_CMD=opencode run

# Acceptance command run in a scratch copy by work-accept / work-finish.
# App-touching cards run the app's own test suites; harness-only cards run
# the harness self-test. See bin/sift-accept for the detection logic.
WORK_ACCEPT_CMD=bin/sift-accept

# Base branch that acceptance and finish target and merge into.
# WORK_BASE_BRANCH=main

# Refuse handover when a plan's declared estimate exceeds this many steps.
# WORK_ESTIMATE_CEILING=25

# Set to 1 to let work-finish push after a successful release/merge. Off by default.
# WORK_PUSH=0

# Project release adapter. work-finish requires --approve <source-revision>
# when this is set, runs the adapter against the pinned source, and writes
# done.md / publishes the one squash commit only after it exits 0. Remove or
# leave empty for a generic project without a release step.
WORK_RELEASE_CMD=python3 bin/sift-promote

# ── Sifty deploy environments (bin/sift-deploy) ──────────────────────────────
# Destinations resolve against the MAIN checkout, never a linked worktree, so
# artifacts built from .worktrees/<id> survive that worktree's removal.
# Production and staging must not share data, binary, bundle or worker paths.
SIFTY_PROD_PORT=8080
SIFTY_STAGING_PORT=8081
# SIFTY_PROD_DATA_DIR=<main>/data                          (default)
# SIFTY_STAGING_DATA_DIR=<main>/data-staging               (default)
# SIFTY_PROD_BINARY=<main>/bin/sifty                       (default)
# SIFTY_STAGING_BINARY=<main>/bin/sifty-staging            (default)
# SIFTY_PROD_DIST=<main>/frontend/dist                     (default)
# SIFTY_STAGING_DIST=<main>/frontend/dist-staging          (default)
# SIFTY_PROD_WORKERS_DIR=<main>/backend/workers-prod       (default)
# SIFTY_STAGING_WORKERS_DIR=<main>/backend/workers-staging (default)
# SIFTY_WORKERS_SOURCE=<checkout>/backend/workers          (source only)
# SIFTY_DEPLOY_STATE_DIR=<main>/.local/deploy              (default)
# The obsolete shared SIFTY_WORKERS_DIR is refused.

# ── Continuous preview (bin/sift-preview) ────────────────────────────────────
# One supervisor per main repository. It watches the selected worktree's
# frontend, backend and worker sources (including uncommitted/untracked files)
# and serves a local status/injection proxy on the preview port.
# SIFTY_PREVIEW_PORT=8081
# SIFTY_PREVIEW_DATA_DIR=<repo>/data-staging
# SIFTY_PREVIEW_STATE_DIR=<repo>/.local/preview
# SIFTY_PREVIEW_POLL_SECONDS=1.0
# SIFTY_PREVIEW_DEBOUNCE_SECONDS=1.0
# SIFTY_WORKERS_SOURCE=<checkout>/backend/workers
# SIFTY_WORKERS_CACHE_DIR=<main>/.local/cache/workers
# SIFTY_FRONTEND_CACHE_DIR=<main>/.local/cache/frontend
#
# Reserved preview adapter seam; no current work-* command invokes it:
# WORK_PREVIEW_CMD=bin/sift-preview start --worktree <path> --label <id>
