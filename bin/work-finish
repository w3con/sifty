#!/usr/bin/env python3
"""work-finish — accept, release and publish one card, or reject it.

Usage:
    work-finish <id> [--force] [--approve <revision>] [-m <subject>]
    work-finish <id> --reject "<reason>"

Accept path: require the current checkout to be the base branch (default main),
the source worktree and target checkout clean including untracked files, every
step closed, the plan fit (present, non-empty, with steps and acceptance
criteria, no malformed step line), attention resolved and no terminal outcome.
Capture the source and target revisions, run acceptance checks in a scratch copy
detached at the captured source SHA, and verify both revisions/branches are
unchanged.

The checked source is published as exactly ONE Conventional Commits squash
commit on the base branch, not as its checkpoint history plus a separate finish
commit. The commit tree is the checked source tree plus the generated done.md;
its parent is the captured target revision. When WORK_RELEASE_CMD is configured,
work-finish requires `--approve <source revision>` and runs the release adapter
against the immutable source revision and prepared squash commit. done.md and
main become authoritative only after that adapter exits successfully. A failed
acceptance, release or publish writes no done.md and preserves the source
branch, worktree, recovery refs and main exactly as they were.

--force skips only the acceptance command. It never bypasses approval, release,
readiness, cleanliness, revision or preservation checks.

Reject path: write rejected.md with the reason and commit only that file on the
base branch. The work branch, worktree, uncommitted changes and pre-existing
staged/unstaged target changes are preserved; nothing is removed or merged.

The generic harness never imports project deployment code. A project configures
its release adapter with WORK_RELEASE_CMD; Sifty sets it to bin/sift-promote,
which builds and verifies the pinned source revision. Generic projects without
a configured adapter finish without a release step.

Never pushes unless WORK_PUSH=1 is set (off by default).
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _work_lib as w


def write_terminal(card_dir, name, body):
    with open(os.path.join(card_dir, name), "w", encoding="utf-8") as fh:
        fh.write(body)


def commit_card(card_dir, message, only=None):
    """Commit one terminal record without sweeping in pre-existing staged work.

    `git commit --only` commits the named path from the working tree and leaves
    every other staged or unstaged change in the index/worktree untouched. This
    is required for rejection, which deliberately runs with dirty target work."""
    rel = os.path.relpath(card_dir, w.repo_root())
    path = os.path.join(rel, only) if only else rel
    added = w.run(["git", "add", "--", path], cwd=w.repo_root())
    if added.returncode != 0:
        w.die("git add failed: %s" % (added.stderr or added.stdout).strip())
    cp = w.run(["git", "commit", "-q", "--only", "-m", message, "--", path],
               cwd=w.repo_root())
    if cp.returncode != 0:
        w.die("git commit failed: %s" % (cp.stderr or cp.stdout).strip())


def reject_card(card_dir, card_id, branch, target_root, reason):
    """Record the rejection on the base branch without touching the work copy."""
    state = w.card_state(card_dir)
    if state["errors"]:
        w.refuse(["cannot reject %s: %s"
                  % (card_id, "; ".join(state["errors"]))])
    wt = w.find_worktree(branch, cwd=target_root)
    source_card = w.find_card_dir(card_id, root=wt) if wt else None
    existing = w.terminal_file_present(card_dir)
    if not existing and source_card:
        existing = w.terminal_file_present(source_card)
    if existing in ("done.md", "rejected.md", "cancelled.md"):
        w.refuse(["cannot reject %s: terminal file already present: %s"
                  % (card_id, existing)])
    tip = w.git_rev(branch, cwd=target_root)
    if tip is None:
        w.refuse(["cannot reject %s: no branch %s" % (card_id, branch)])

    dirty = w.git_status_lines(wt) if wt else []
    if dirty:
        preservation = ("The work branch and worktree were preserved. Uncommitted "
                        "changes remain in %s:\n\n%s\n"
                        % (wt, "\n".join("    " + line for line in dirty)))
    else:
        preservation = ("The work branch and worktree were preserved. No "
                        "uncommitted changes were present.")
    body = ("# %s — rejected\n\n**Date:** %s\n**Branch tip was:** %s\n\n"
            "## Reason\n\n%s\n\n## Preservation\n\n%s\n"
            % (card_id, w.today(), tip, reason, preservation))
    write_terminal(card_dir, "rejected.md", body)
    commit_card(card_dir, "chore(work): reject %s" % card_id,
                only="rejected.md")
    w.info("rejected %s; branch %s and worktree preserved" % (card_id, branch))


def main():
    ap = argparse.ArgumentParser(prog="work-finish")
    ap.add_argument("id")
    ap.add_argument("--reject", default=None, metavar="REASON")
    ap.add_argument("--force", action="store_true",
                    help="skip only the acceptance command; approval, release, "
                         "readiness, cleanliness and revision checks still apply")
    ap.add_argument("--approve", default=None, metavar="REVISION",
                    help="explicit owner approval of the pinned source revision; "
                         "required when WORK_RELEASE_CMD is configured")
    ap.add_argument("-m", "--message", default=None, metavar="SUBJECT",
                    help="Conventional Commits subject for the one squash commit")
    args = ap.parse_args()

    card_dir = w.require_card_dir(args.id)
    branch = "work/%s" % args.id
    base = w.base_branch()
    target_root = w.repo_root()

    current = w.git_current_branch(target_root)
    if current != base:
        w.refuse(["target branch is %r, not %r; run work-finish from the base "
                  "checkout" % (current, base)])

    # ── Reject path ──────────────────────────────────────────────────────────
    if args.reject is not None:
        reject_card(card_dir, args.id, branch, target_root, args.reject)
        return

    # ── Accept path ──────────────────────────────────────────────────────────
    snapshot = w.finish_snapshot(args.id)
    problems = w.readiness_problems(args.id)
    if problems:
        w.refuse(["cannot finish %s:" % args.id] + problems)

    source_sha = snapshot["source_sha"]
    target_sha = snapshot["target_sha"]
    target_branch = snapshot["target_branch"]

    if not args.force:
        code, output, accept_problems = w.run_accept(
            args.id, source_sha, target_sha, target_branch)
        sys.stdout.write(output)
        if output and not output.endswith("\n"):
            sys.stdout.write("\n")
        if accept_problems:
            w.refuse(["acceptance could not be verified for %s:" % args.id]
                     + accept_problems)
        if code != 0:
            w.refuse(["acceptance checks failed (exit %d) — not merging. "
                      "Work branch and worktree preserved." % code])

    # Re-verify the exact tested snapshot immediately before merging.
    problems = w.readiness_problems(args.id)
    if problems:
        w.refuse(["cannot finish %s after acceptance:" % args.id] + problems)
    now = w.finish_snapshot(args.id)
    if now["source_sha"] != source_sha:
        w.refuse(["source revision changed during acceptance: %s -> %s; "
                  "work branch and worktree preserved"
                  % (source_sha, now["source_sha"])])
    if now["target_branch"] != target_branch or now["target_sha"] != target_sha:
        w.refuse(["target moved during acceptance: %s@%s -> %s@%s; "
                  "work branch and worktree preserved"
                  % (target_branch, target_sha, now["target_branch"],
                     now["target_sha"])])

    # ── Approval and release adapter ─────────────────────────────────────────
    release_cmd = w.release_command(source_root=now["worktree"])
    approval = None
    if args.approve:
        approval = w.git_rev("%s^{commit}" % args.approve, cwd=target_root)
        if not approval:
            w.refuse(["--approve %r is not a commit" % args.approve])
        if approval != source_sha:
            w.refuse(["approval is for %s but the checked source is %s; "
                      "approve the exact pinned revision"
                      % (approval, source_sha)])
    if release_cmd and not approval:
        w.refuse(["WORK_RELEASE_CMD is configured (%r), so product completion "
                  "requires --approve <source-revision>. The checked source is %s."
                  % (release_cmd, source_sha)])

    # ── Prepare the one card commit without moving any ref ───────────────────
    source_card_dir = w.find_card_dir(args.id, root=now["worktree"])
    if not source_card_dir:
        w.refuse(["card %s is missing from the source worktree %s"
                  % (args.id, now["worktree"])])
    squash = w.prepare_squash(args.id, source_sha, target_sha, target_branch,
                              source_card_dir, now["worktree"],
                              subject=args.message, target_root=target_root)
    w.info("source revision: %s" % source_sha)
    w.info("squash revision: %s (%s)" % (squash["squash_sha"],
                                         squash["subject"]))
    w.info("target revision: %s@%s" % (target_branch, target_sha))

    # The prepared tree must be the checked source plus done.md at the SOURCE
    # card location before any release is attempted.
    equality = w.squash_content_problems(
        source_sha, squash["squash_sha"], args.id,
        target_root=target_root, source_worktree=now["worktree"])
    if equality:
        w.refuse(["prepared squash does not match the checked source:"] + equality)

    # git commit-tree bypasses hooks; run the approved source's real scanners
    # on the prepared commit before release or publication.
    guard_code, guard_output, guard_problems = w.run_commit_guards(
        squash, args.id, squash["subject"],
        source_worktree=now["worktree"], target_root=target_root)
    sys.stdout.write(guard_output)
    if guard_output and not guard_output.endswith("\n"):
        sys.stdout.write("\n")
    if guard_problems:
        w.refuse(["commit guards rejected the prepared card commit; nothing "
                  "was released:"] + guard_problems)
    w.info("commit guards passed for squash %s" % squash["squash_sha"])

    release_succeeded = False

    def post_release_refuse(reasons):
        """Refuse after a successful release and ask the adapter to recover."""
        reasons = list(reasons)
        if release_succeeded and release_cmd:
            w.info("release already advanced production; requesting recovery")
            rec_code, rec_output, rec_error = w.run_release_recovery(
                args.id, now, squash, approval, "; ".join(reasons),
                command=release_cmd)
            sys.stdout.write(rec_output)
            if rec_output and not rec_output.endswith("\n"):
                sys.stdout.write("\n")
            if rec_error:
                reasons.append("production recovery was not requested: %s"
                               % rec_error)
            elif rec_code == 0:
                reasons.append("production recovery reported success; done.md "
                               "was not published")
            else:
                reasons.append(
                    "production recovery FAILED (exit %s); production may "
                    "still run source %s; inspect the adapter output above"
                    % (rec_code, source_sha))
        elif release_succeeded:
            reasons.append("no release adapter is configured; production "
                           "recovery was not requested")
        else:
            reasons.append("no production release had succeeded; no recovery "
                           "was requested")
        w.refuse(reasons)

    # ── Release the immutable source, then publish the prepared commit ───────
    if release_cmd:
        w.info("release adapter: %s" % release_cmd)
        code, output = w.run_release(args.id, now, squash, approval,
                                     command=release_cmd)
        sys.stdout.write(output)
        if output and not output.endswith("\n"):
            sys.stdout.write("\n")
        if code != 0:
            w.refuse(["release failed (exit %s) for source %s; no done.md, main "
                      "unchanged, work branch and worktree preserved"
                      % (code, source_sha)])
        release_succeeded = True
        w.info("release succeeded for source %s" % source_sha)
    else:
        w.info("no WORK_RELEASE_CMD configured; no release adapter was run")

    # The release adapter must not have moved the source or target behind us.
    problems = w.readiness_problems(args.id)
    if problems:
        post_release_refuse(["cannot publish %s after release:" % args.id]
                            + problems)
    after = w.finish_snapshot(args.id)
    if after["source_sha"] != source_sha:
        post_release_refuse(
            ["source revision changed during release: %s -> %s; main is "
             "currently %s@%s; source branch and worktree preserved"
             % (source_sha, after["source_sha"],
                w.git_current_branch(target_root),
                w.git_rev("HEAD", cwd=target_root))])
    if after["target_branch"] != target_branch or after["target_sha"] != target_sha:
        post_release_refuse(
            ["target moved during release: %s@%s -> %s@%s; production was "
             "already released for source %s; main is at the observed target, "
             "not claimed unchanged"
             % (target_branch, target_sha, after["target_branch"],
                after["target_sha"], source_sha)])

    merge = w.run(["git", "merge", "--ff-only", squash["squash_sha"]],
                  cwd=target_root)
    if merge.returncode != 0:
        post_release_refuse(
            ["publishing prepared squash %s failed; production was already "
             "released for source %s. main is currently %s@%s, not claimed "
             "unchanged; the source branch/worktree are preserved.\n%s"
             % (squash["squash_sha"], source_sha,
                w.git_current_branch(target_root),
                w.git_rev("HEAD", cwd=target_root),
                (merge.stderr or merge.stdout).strip())])
    merged_sha = w.git_rev("HEAD", cwd=target_root)
    if merged_sha != squash["squash_sha"]:
        post_release_refuse(
            ["publish produced %s instead of the prepared %s; production was "
             "already released for source %s; main is at the observed commit "
             "and the work branch is preserved"
             % (merged_sha, squash["squash_sha"], source_sha)])
    w.info("published one card commit %s on %s" % (merged_sha, base))

    final_card = w.find_card_dir(args.id)
    if not final_card or not os.path.isfile(os.path.join(final_card, "done.md")):
        w.die("published squash %s but done.md is not present in the target; "
              "the work branch is preserved" % merged_sha)

    for problem in w.cleanup_finished(args.id, source_sha,
                                      published_sha=squash["squash_sha"],
                                      source_worktree=now["worktree"]):
        w.info("WARNING: %s" % problem)

    if w.config_get("WORK_PUSH") == "1":
        push = w.run(["git", "push"], cwd=w.repo_root())
        if push.returncode != 0:
            w.info("WARNING: push failed: %s" % push.stderr.strip())
    w.info("finished %s" % args.id)

    # The roadmap holds the card sequence and status as curated prose; it cannot be
    # updated mechanically, so the finish step reminds the coordinator to do it by hand.
    roadmap = os.path.join(w.repo_root(), "work", "ROADMAP.md")
    if os.path.exists(roadmap):
        w.info("ROADMAP — now update work/ROADMAP.md: move %s to done/Status and set the "
               "next card in the queue. Not automatic; the sequence there is curated prose." % args.id)


if __name__ == "__main__":
    main()
