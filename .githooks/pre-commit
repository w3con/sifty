#!/usr/bin/env bash
# pre-commit dispatcher.
#
# Runs every executable in .githooks/pre-commit.d in lexical order so that
# independent hook owners coexist: 10-kb-relation-build refreshes the kb ai:
# blocks (non-blocking by design, always exits 0), 20-work-selfcheck refuses a
# syntactically broken work-* harness script. A step's non-zero exit blocks the
# commit; add a step by dropping an executable file in pre-commit.d.
set -u
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)/pre-commit.d"
[ -d "$HOOK_DIR" ] || exit 0
rc=0
for h in "$HOOK_DIR"/*; do
    [ -f "$h" ] && [ -x "$h" ] || continue
    "$h" "$@" || rc=$?
done
exit $rc
