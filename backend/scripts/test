#!/usr/bin/env bash
# test — the single build-and-test entry used by CI and by hand. It grows with the repository:
# the leak-scanner self-test always runs; the Go build, vet and tests run once a go.mod exists;
# the worker tests run once a worker package exists. Each stage is guarded so the entry runs
# cleanly at every stage of the migration.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
fail=0

echo "== leak-scanner self-test =="
python3 scripts/leakcheck/leakcheck-selftest || fail=1

if [ -f go.mod ]; then
    echo "== go vet =="
    go vet ./... || fail=1
    echo "== go build =="
    go build ./... || fail=1
    echo "== go test =="
    go test -race ./... || fail=1
else
    echo "== go: no go.mod yet, skipping build and test =="
fi

for pkg in workers/*/package.json; do
    [ -f "$pkg" ] || continue
    dir="$(dirname "$pkg")"
    if grep -q '"test"' "$pkg"; then
        echo "== worker test: $dir =="
        ( cd "$dir" && npm test ) || fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "test: FAILED"
    exit 1
fi
echo "test: OK"
