#!/usr/bin/env python3
"""sift-data-refresh — explicitly refresh staging data from production.

Usage: sift-data-refresh [--env staging] [--from PATH] [--no-restart] [--help]

This is a deliberate data operation, separate from code deploys. It stops the
recorded staging server, keeps the previous staging data under
<staging>/.refresh-backup/<timestamp>/, takes a consistent SQLite backup of the
production database, and copies production config/evidence/answers/feedback
plus cv.pdf/profile.pdf. WAL/SHM files are removed before replacement. On
failure the previous staging data is restored.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _deploy_lib as d


def main():
    if "--help" in sys.argv[1:] or "-h" in sys.argv[1:]:
        print(__doc__.strip())
        return 0
    try:
        return d.refresh_main(__file__, sys.argv[1:])
    except d.DeployError as exc:
        print("sift-data-refresh: ERROR: %s" % exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
