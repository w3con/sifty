#!/usr/bin/env python3
"""work-commit — commit the executor's work to its own branch.

Usage:
    work-commit <id> -m MESSAGE

Run from inside the work/<id> worktree. Refuses to commit anywhere other than
branch work/<id>, so executor work can never land on the base branch or main.
MESSAGE is required and must be a Conventional Commits subject:
type(scope): imperative summary.
"""
import argparse
import os
import re
import sys

CONVENTIONAL = re.compile(
    r"^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)"
    r"(\([^()\s]+\))?!?: \S")

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _work_lib as w


def main():
    ap = argparse.ArgumentParser(prog="work-commit")
    ap.add_argument("id")
    ap.add_argument("-m", "--message", required=True,
                    help="Conventional Commits message: type(scope): summary")
    args = ap.parse_args()

    if not CONVENTIONAL.match(args.message):
        w.refuse(["commit message %r is not a Conventional Commits subject; "
                  "use type(scope): imperative summary, e.g. "
                  "'feat(config): add preparation stage'" % args.message])

    expected = "work/%s" % args.id
    branch = w.git_current_branch()
    if branch != expected:
        w.refuse(["refusing to commit on branch %r; the executor commits only "
                  "on %r. Run from inside the work/<id> worktree."
                  % (branch, expected)])

    status = w.run(["git", "status", "--porcelain"])
    if not status.stdout.strip():
        w.refuse(["nothing to commit on %s" % expected])

    add = w.run(["git", "add", "-A"])
    if add.returncode != 0:
        w.die("git add failed: %s" % add.stderr.strip())

    msg = args.message
    commit = w.run(["git", "commit", "-q", "-m", msg])
    if commit.returncode != 0:
        w.die("git commit failed: %s" % (commit.stderr or commit.stdout).strip())

    head = w.run(["git", "rev-parse", "--short", "HEAD"]).stdout.strip()
    w.info("committed %s on %s" % (head, expected))


if __name__ == "__main__":
    main()
